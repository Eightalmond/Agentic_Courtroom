# Required only when running a synthetic customer simulation or courtroom advocate.
# Groq is the recommended local provider and the default when LLM_PROVIDER is unset.
# Keep all provider values server-side. Never prefix them with NEXT_PUBLIC_.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# OpenAI is an alternative. Set LLM_PROVIDER=openai to select it.
OPENAI_API_KEY=
OPENAI_MODEL=

# No other environment variables are currently required.
# Add future server-side settings below without including real secrets.
