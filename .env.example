# Public demo behavior. Unknown values fail safely to true.
DEMO_MODE=true

# Best-effort per-instance limits. These are not globally consistent across
# Vercel serverless instances and are not a replacement for distributed limits.
SIMULATION_RATE_LIMIT=30
COURTROOM_RATE_LIMIT=10
RATE_LIMIT_WINDOW_SECONDS=600

# Required only when running a synthetic customer simulation or courtroom agent.
# Groq is the recommended local provider and the default when LLM_PROVIDER is unset.
# Keep all provider values server-side. Never prefix them with NEXT_PUBLIC_.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# OpenAI is an alternative. Set LLM_PROVIDER=openai to select it.
OPENAI_API_KEY=
OPENAI_MODEL=
